#version 450

// MUL_MAT_ID for small batches, grouped by expert ("tiled matvec").
// count_experts groups the (token, slot) pairs by expert into tiles of NUM_COLS
// columns. Each workgroup computes NUM_ROWS output rows of one tile: it decodes
// each A (weight) block once and dots it with all of the tile's q8_1 columns, so
// a routed expert's weights are read once per tile however many tokens share it.
// The per-column arithmetic is the same as mul_mat_vecq.comp (MUL_MAT_ID), so the
// result of a column does not depend on which other columns share its tile.

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#define MMQ
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_iface.glsl"

layout (binding = 5) readonly buffer MAP {uint data_map[];};

layout (push_constant) uniform parameter
{
    uint ncols;          // K
    uint stride_b;       // elements between B rows of consecutive slots
    uint batch_stride_a; // elements per expert
    uint batch_stride_b; // elements per token
    uint stride_d;       // dst elements per slot
    uint batch_stride_d; // dst elements per token
    uint ne11;           // B rows per token (1 = broadcast over slots)
    uint nrows;          // M
    uint row_ids_offset;
} p;

layout (constant_id = 0) const uint BLOCK_SIZE = 16;
layout (constant_id = 1) const uint NUM_ROWS = 1;
layout (constant_id = 2) const uint NUM_COLS = 8;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if defined(DATA_A_QUANT_K)
#define K_PER_ITER 16
#elif defined(DATA_A_QUANT_LEGACY)
#define K_PER_ITER 8
#else
#error unimplemented
#endif

// referenced by mmvq_dot_product in the shared funcs; unused here
int32_t cache_b_qs[K_PER_ITER / 4];
vec2 cache_b_ds;

#include "mul_mat_vecq_funcs.glsl"

#if defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1)
#define DM_TYPE FLOAT_TYPEV2
#else
#define DM_TYPE FLOAT_TYPE
#endif

uint a_offset;
uint b_offs[NUM_COLS];

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
    i32vec4 bq[NUM_COLS];
    vec2 bd[NUM_COLS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        const uint b_block_idx = col / QUANT_K_Q8_1 + b_offs[j];
        const uint bo = b_block_idx / 4;
        const uint bi = b_block_idx % 4;
        bd[j] = vec2(data_b[bo].ds[bi]);
#if K_PER_ITER == 16
        bq[j] = i32vec4(data_b[bo].qs[bi * 8 + b_qs_idx * 4    ],
                        data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 1],
                        data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 2],
                        data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 3]);
#elif QUANT_R == 2
        bq[j] = i32vec4(data_b[bo].qs[bi * 8 + b_qs_idx], data_b[bo].qs[bi * 8 + b_qs_idx + 4], 0, 0);
#else
        bq[j] = i32vec4(data_b[bo].qs[bi * 8 + b_qs_idx * 2], data_b[bo].qs[bi * 8 + b_qs_idx * 2 + 1], 0, 0);
#endif
    }

    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        if (n >= num_rows) {
            break;
        }
        const uint ib = ((first_row + n) * p.ncols + col) / QUANT_K_Q8_1 + a_offset;
#if defined(DATA_A_QUANT_K)
        const i32vec4 qa = repack4(ib, b_qs_idx * 4);
        const vec2 dm = get_dm_scale(ib, b_qs_idx * 4);
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            int32_t q = dotPacked4x8EXT(qa.x, bq[j].x);
            q += dotPacked4x8EXT(qa.y, bq[j].y);
            q += dotPacked4x8EXT(qa.z, bq[j].z);
            q += dotPacked4x8EXT(qa.w, bq[j].w);
            temp[j][n] += FLOAT_TYPE(float(bd[j].x) * float(dm.x) * float(q) - float(dm.y) * float(bd[j].y / 2));
        }
#else
#if QUANT_R == 2
        const i32vec2 qa = repack(ib, b_qs_idx);
#else
        const i32vec2 qa = i32vec2(repack(ib, b_qs_idx * 2), repack(ib, b_qs_idx * 2 + 1));
#endif
        const DM_TYPE dm = get_dm(ib);
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            int32_t q = dotPacked4x8EXT(qa.x, bq[j].x);
            q += dotPacked4x8EXT(qa.y, bq[j].y);
            temp[j][n] += mul_q8_1(q, dm, bd[j], 4);
        }
#endif
    }
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint tile = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    if (tile >= data_map[0]) {
        return;
    }
    const uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    if (first_row >= p.nrows) {
        return;
    }
    const uint num_rows = min(NUM_ROWS, p.nrows - first_row);

    const uint expert = data_map[1 + 2 * tile];
    const uint cnt = data_map[2 + 2 * tile];

    uint d_offs[NUM_COLS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        // unused columns repeat the last one and are not stored
        const uint packed = data_map[p.row_ids_offset + tile * NUM_COLS + min(j, cnt - 1)];
        const uint i1 = packed >> 16;
        const uint i0 = packed & 0xFFFF;
        b_offs[j] = ((i0 % p.ne11) * p.stride_b + i1 * p.batch_stride_b) / QUANT_K_Q8_1;
        d_offs[j] = i0 * p.stride_d + i1 * p.batch_stride_d;
    }
    a_offset = expert * (p.batch_stride_a / QUANT_K_Q8_1);

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    const uint b_qs_idx = tid % (32 / K_PER_ITER);
    uint col = tid * K_PER_ITER;
    while (num_iters >= 2) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        num_iters -= 2;
    }
    if (num_iters > 0) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
    }

    // one subgroup per workgroup (required subgroup size == BLOCK_SIZE)
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            temp[j][n] = subgroupAdd(temp[j][n]);
        }
    }
    if (tid == 0) {
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            if (j >= cnt) {
                break;
            }
            [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                if (n >= num_rows) {
                    break;
                }
                data_d[d_offs[j] + first_row + n] = D_TYPE(temp[j][n]);
            }
        }
    }
}
