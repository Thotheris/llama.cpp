layout (constant_id = 11) const uint ALIGNED = 0;

#ifdef MULMAT_QUANT

uint mm_load_vec_a() {
    switch (MmTypeA) {
    case GGML_TYPE_Q1_0:
    case GGML_TYPE_Q4_0:
    case GGML_TYPE_Q4_1:
    case GGML_TYPE_Q5_1:
        return 8u;
    case GGML_TYPE_Q2_0:
    case GGML_TYPE_Q5_0:
    case GGML_TYPE_Q8_0:
    case GGML_TYPE_Q2_K:
#ifndef MUL_MAT_ID
    case GGML_TYPE_Q4_K:
#endif
    case GGML_TYPE_Q5_K:
        return 4u;
#ifdef MUL_MAT_ID
    // matmul_id dequantises a full BM x K slab per expert tile, so the A loader dominates;
    // 16 weights per call share one scale/min decode and two 16-byte loads
    case GGML_TYPE_Q4_K:
        return 16u;
#endif
    default:
        return 2u;
    }
}
#endif

#if !defined(TO_FLOAT_TYPE)
