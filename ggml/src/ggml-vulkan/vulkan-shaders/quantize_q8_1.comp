#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require

#ifdef USE_SUBGROUPS
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require

#define INVOCATION_ID gl_SubgroupInvocationID.x
#else
#define INVOCATION_ID gl_LocalInvocationID.x
#endif

#if !defined(FUSE_SITU) && !defined(FUSE_MUL)
layout (push_constant) uniform parameter
{
    uint ne;
    uint num_blocks;
} p;
#else
// FUSE_SITU: the input is situ(gate, up) of the split GLU (situ.comp), FUSE_MUL the product of two tensors (mul.comp),
// computed here instead of read back: the two srcs are [ncols, rows] f32 with row strides nba1/nbb1 and misalignments oa/ob in elements
layout (push_constant) uniform parameter
{
    uint ne;
    uint num_blocks;
    uint ncols;
    uint nba1;
    uint nbb1;
    uint oa;
    uint ob;
    float alpha;
    float limit;
    float param3;
    float param4;
} p;
#endif

#include "types.glsl"

layout(constant_id = 0) const uint GROUP_SIZE = 32;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if !defined(FUSE_SITU) && !defined(FUSE_MUL)
layout (binding = 0) readonly buffer A {vec4 data_a[];};
#else
layout (binding = 0) readonly buffer A {float data_g[];};
layout (binding = 2) readonly buffer U {float data_u[];};

#ifdef FUSE_MUL
// FUSE_MUL: the input is the same-shape f32 product a*b (mul.comp), computed here instead of read back
float fused_op(float a, float b) {
    precise float r = a * b;
    return r;
}
#else
// situ.comp op(), the same expressions with the values the unfused chain stored marked precise
float situ_tanh(float x) {
    return 1.0f - 2.0f / (exp(2.0f*x) + 1.0f);
}

float situ_sigmoid(float x) {
    return 1.0f / (1.0f + exp(-x));
}

float situ_op(float a, float b) {
    precise float s   = a * p.param3;
    precise float t   = situ_tanh(s);
    precise float act = t * p.alpha;
    precise float sig = situ_sigmoid(a);
    precise float g   = act * sig;
    precise float up  = b;
    if (p.limit > 0.0f) {
        precise float u  = b * p.param4;
        precise float tu = situ_tanh(u);
        up = tu * p.limit;
    }
    precise float r = g * up;
    return r;
}

float fused_op(float a, float b) {
    return situ_op(a, b);
}
#endif
#endif
#ifndef QBLOCK_X4
layout (binding = 1) writeonly buffer D {block_q8_1_packed32 data_b[];};
#else
layout (binding = 1) writeonly buffer D {block_q8_1_x4 data_b[];};
#endif

#ifndef USE_SUBGROUPS
shared float shmem[GROUP_SIZE];
#endif

void quantize(const uint wgid) {
    const uint tid = INVOCATION_ID;

    // Each thread handles a vec4, so 8 threads handle a block
    const uint blocks_per_group = GROUP_SIZE / 8;

    const uint block_in_wg = tid / 8;

    const uint ib = wgid * blocks_per_group + block_in_wg;
    const uint iqs = tid % 8;

#ifdef QBLOCK_X4
    const uint ibx4_outer = ib / 4;
    const uint ibx4_inner = ib % 4;

    const uint required_x4_blocks = (p.ne + 127) / 128;
    if (ibx4_outer >= required_x4_blocks) {
        return;
    }
#endif

    const uint a_idx = ib * 8 + iqs;

#if !defined(FUSE_SITU) && !defined(FUSE_MUL)
    vec4 vals = a_idx < p.ne / 4 ? data_a[a_idx] : vec4(0.0f);
#else
    vec4 vals = vec4(0.0f);
    if (a_idx < p.ne / 4) {
        // ncols % 4 == 0: the four values are in one row
        const uint e = a_idx * 4;
        const uint r = e / p.ncols;
        const uint c = e - r * p.ncols;
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            vals[k] = fused_op(data_g[p.oa + r * p.nba1 + c + k], data_u[p.ob + r * p.nbb1 + c + k]);
        }
    }
#endif
    const vec4 abs_vals = abs(vals);

    // Find absolute max for each block
    const float thread_max = max(max(abs_vals.x, abs_vals.y), max(abs_vals.z, abs_vals.w));
#ifndef USE_SUBGROUPS
    shmem[tid] = thread_max;
    barrier();
    [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
        if (iqs < s) {
            shmem[tid] = max(shmem[tid], shmem[tid + s]);
        }
        barrier();
    }

    const float amax = shmem[block_in_wg * 8];
#else
    const float amax = subgroupClusteredMax(thread_max, 8);
#endif

    const float d = amax / 127.0;
    const float d_inv = d != 0.0 ? 1.0 / d : 0.0;
    vals = round(vals * d_inv);

#ifndef QBLOCK_X4
    data_b[ib].qs[iqs] = pack32(i8vec4(round(vals)));
#else
    data_b[ibx4_outer].qs[ibx4_inner * 8 + iqs] = pack32(i8vec4(round(vals)));
#endif

#ifndef USE_SUBGROUPS
    barrier();
#endif

    // Calculate the sum for each block
    const float thread_sum = vals.x + vals.y + vals.z + vals.w;
#ifndef USE_SUBGROUPS
    shmem[tid] = thread_sum;
    barrier();
    [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
        if (iqs < s) {
            shmem[tid] += shmem[tid + s];
        }
        barrier();
    }
#else
    const float sum = subgroupClusteredAdd(thread_sum, 8);
#endif
    if (iqs == 0) {
#ifndef USE_SUBGROUPS
        const float sum = shmem[tid];
#endif

#ifndef QBLOCK_X4
        data_b[ib].ds = f16vec2(vec2(d, sum * d));
#else
        data_b[ibx4_outer].ds[ibx4_inner] = f16vec2(vec2(d, sum * d));
#endif
    }
}

void main() {
    uint wgid = gl_WorkGroupID.x;
    while (wgid < p.num_blocks) {
        quantize(wgid);
        wgid += gl_NumWorkGroups.x;
    }
}
